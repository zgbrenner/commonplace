#!/usr/bin/env bash
# scripts/lint -- check (never mutate) formatting, then clippy, then the
# frontend linter once it exists.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "${SCRIPT_DIR}/lib.sh"

run_step "cargo fmt --all --check" cargo fmt --all --check
run_step "cargo clippy --workspace --all-targets -- -D warnings" \
  cargo clippy --workspace --all-targets -- -D warnings

if has_frontend; then
  step_header "Frontend lint"
  if owner="$(npm_script_owner lint)"; then
    dir="$(npm_script_dir "${owner}")"
    run_step "npm run lint (${owner}: ${dir})" bash -c "cd \"${dir}\" && npm run lint"
  else
    info "No 'lint' script defined yet in root or apps/desktop package.json -- skipping."
  fi
else
  info "No frontend at apps/desktop yet -- skipping frontend lint."
fi

step_header "lint complete"
